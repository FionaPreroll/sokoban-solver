{
  "name": "sokoban-solver",
  "version": "2.0.0",
  "private": true,
  "description": "Sokoban level editor and move-optimal solver that runs in the browser.",
  "license": "GPL-3.0-only",
  "author": "Fiona <fipreroll+app@gmail.com>",
  "homepage": "https://fionapreroll.github.io/sokoban-solver/",
  "repository": {
    "type": "git",
    "url": "https://github.com/FionaPreroll/sokoban-solver.git"
  },
  "bugs": {
    "url": "https://github.com/FionaPreroll/sokoban-solver/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:fuzz": "vitest run --project fuzz",
    "test:soak": "vitest run --project soak",
    "test:e2e": "playwright test",
    "bench": "node bench/core.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "pcface": "0.3.0"
  }
}
